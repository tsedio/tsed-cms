{
  "name": "tsed-flow-sponsors",
  "description": "Flow to import sponsors from GitHub and OpenCollective into Directus sponsors collection",
  "icon": "favorite",
  "version": "1.0.0",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-operation"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "directus:extension": {
    "type": "operation",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.cjs"
    },
    "source": {
      "app": "src/app.ts",
      "api": "src/api.ts"
    },
    "host": "^10.10.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build --watch --no-minify",
    "link": "directus-extension link",
    "add": "directus-extension add"
  },
  "dependencies": {
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "13.1.1"
  }
}
