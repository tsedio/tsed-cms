{
  "name": "@tsed-cms/root",
  "version": "1.0.3",
  "description": "Ts.ED CMS Directus",
  "main": "index.js",
  "type": "module",
  "homepage": "https://tsed.dev/",
  "bugs": {
    "url": "https://github.com/tsedio/tsed/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/Romakita"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/tsed"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tsedio/tsed-cms.git"
  },
  "scripts": {
    "env": "dotenv-flow -p ./config",
    "env:dev": "cross-env NODE_ENV=development dotenv-flow -p ./config",
    "env:heroku": "cross-env NODE_ENV=heroku dotenv-flow -p ./config",
    "directus": "directus",
    "start": "npx directus start",
    "bootstrap": "yarn env -- yarn directus bootstrap",
    "bootstrap:dev": "yarn build:migrations && yarn env:dev -- yarn directus bootstrap",
    "init": "yarn env -- yarn directus init",
    "start:prod": "yarn env -- yarn start",
    "start:prod:all": "yarn bootstrap && yarn migrate && yarn start:prod",
    "import:data": "yarn env -- node --import @swc-node/register/esm-register ./packages/scripts/import-data.ts",
    "import:data:dev": "yarn env:dev -- node --import @swc-node/register/esm-register ./packages/scripts/import-data.ts",
    "import:data:heroku": "yarn env:heroku -- node --import @swc-node/register/esm-register ./packages/scripts/import-data.ts",
    "import:single:heroku": "yarn env:heroku -- node --import @swc-node/register/esm-register ./packages/scripts/import-single.ts",
    "import:single:dev": "yarn env:dev -- node --import @swc-node/register/esm-register ./packages/scripts/import-single.ts",
    "start:dev": "yarn migrate:dev && yarn env:dev -- directus start",
    "watch:dev": "nodemon --config nodemon.json --exec 'nx run-many --target=build --all --parallel'",
    "test": "yarn vitest run",
    "test:watch": "yarn vitest",
    "test:ci": "yarn vitest run --reporter=junit --outputFile=./reports/vitest/test-results.xml",
    "test:lint": "yarn eslint .",
    "test:lint:fix": "yarn eslint . --fix",
    "export:system:collections": "yarn env:dev -- node --import @swc-node/register/esm-register ./packages/scripts/export-collections.ts",
    "create:extension": "cd extensions && npm init directus-extension",
    "lint-staged": "lint-staged",
    "build": "yarn typecheck && nx run-many --target=build --all && yarn build:migrations",
    "build:affected": "nx affected --target=build --base=main",
    "build:dev:affected": "nx affected --target=dev --base=main",
    "build:migrations": "tsdown",
    "typecheck": "yarn tsc --noEmit",
    "release": "semantic-release",
    "release:dryRun": "semantic-release --dry-run",
    "prepare": "husky",
    "nx": "nx",
    "nx:graph": "nx graph",
    "migrate": "yarn build:migrations && yarn env -- yarn directus database migrate:latest",
    "migrate:dev": "yarn build:migrations && yarn env:dev -- yarn directus database migrate:latest",
    "migrate:create": "yarn env:dev -- node --import @swc-node/register/esm-register ./packages/scripts/create-migration.ts",
    "snapshot:create": "yarn env:dev -- yarn directus schema snapshot ./snapshots/snapshot-latest.yaml",
    "snapshot:apply": "yarn env yarn directus schema apply -y ./snapshots/snapshot-latest.yaml",
    "snapshot:apply:dev": "yarn env:dev -- yarn directus schema apply ./snapshots/snapshot-latest.yaml",
    "snapshot:diff": "yarn env:dev -- yarn directus schema apply --dry-run ./snapshots/snapshot-latest.yaml",
    "build:cms:types": "yarn env:dev -- yarn run generate",
    "generate": "directus-sdk-typegen types generate -u ${CMS_API_URL} -t ${CMS_API_TOKEN} -o ./packages/infra/directus/interfaces/DirectusSchema.d.ts && node ./packages/scripts/post-generate.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@directus/sdk": "20.0.0",
    "@nx/devkit": "18.1.3",
    "@nx/eslint": "18.1.3",
    "@nx/jest": "18.1.3",
    "@nx/js": "18.1.3",
    "@nx/node": "18.1.3",
    "@nx/workspace": "18.1.3",
    "@octokit/rest": "^22.0.1",
    "@octokit/types": "^16.0.0",
    "@tsed/ajv": "8.18.0",
    "@tsed/config": "8.18.0",
    "@tsed/core": "8.18.0",
    "@tsed/di": "8.18.0",
    "@tsed/exceptions": "8.18.0",
    "@tsed/hooks": "8.18.0",
    "@tsed/json-mapper": "8.18.0",
    "@tsed/logger": "8.0.4",
    "@tsed/logger-connect": "8.0.4",
    "@tsed/openspec": "8.18.0",
    "@tsed/schema": "8.18.0",
    "ajv": "8.17.1",
    "axios": "1.13.1",
    "axios-retry": "4.5.0",
    "directus": "11.12.0",
    "dotenv": "16.5.0",
    "dotenv-expand": "12.0.2",
    "dotenv-flow": "4.1.0",
    "dotenv-flow-cli": "1.1.1",
    "inquirer": "9.2.16",
    "lodash": "4.17.21",
    "moment": "^2.30.1",
    "nx": "18.1.3",
    "pg": "8.16.0",
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/gitlab": "13.2.4",
    "@swc-node/core": "^1.13.3",
    "@swc-node/register": "^1.10.10",
    "@swc/core": "1.13.20",
    "@tsed/monorepo-utils": "3.0.0",
    "@types/lodash": "4.17.20",
    "@types/moment": "^2.13.0",
    "@types/node": "22.13.14",
    "@types/supertest": "^2.0.12",
    "@types/url-parse": "1.4.11",
    "@typescript-eslint/eslint-plugin": "8.33.1",
    "@typescript-eslint/parser": "8.33.1",
    "@unhead/vue": "^2.0.12",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "directus-sdk-typegen": "0.2.0",
    "eslint": "9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-formatter-gitlab": "6.0.0",
    "eslint-plugin-prettier": "5.4.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "16.2.0",
    "globby": "14.1.0",
    "husky": "9.1.7",
    "knex": "3.1.0",
    "lint-staged": "16.1.0",
    "nodemon": "3.1.10",
    "pinia": "3.0.3",
    "prettier": "3.5.3",
    "semantic-release": "25.0.1",
    "semantic-release-slack-bot": "4.0.2",
    "supertest": "7.1.1",
    "tsdown": "0.15.12",
    "typescript": "5.8.3",
    "vitest": "3.2.1"
  },
  "keywords": [
    "directus",
    "cms",
    "api"
  ],
  "author": "Romain Lenzotti",
  "license": "MIT",
  "lint-staged": {
    "*.{js,ts,mjs,cjs,jsx,tsx}": [
      "eslint --fix"
    ],
    "*.{yml,yaml}": [
      "prettier --write"
    ]
  },
  "flow": {
    "branch": {
      "develop": "main",
      "production": "main"
    },
    "bumpMethod": "cmflow"
  },
  "workspaces": [
    "extensions/*",
    "packages/*"
  ],
  "packageManager": "yarn@4.9.2",
  "monorepo": {
    "productionBranch": "main",
    "developBranch": "main",
    "npmAccess": "public",
    "skipNpmPublish": true
  }
}
