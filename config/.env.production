# Auth
# File Storage
#STORAGE_LOCATIONS=s3
#STORAGE_S3_DRIVER=s3
#STORAGE_S3_BUCKET=cms-digital-api-prod
#STORAGE_S3_REGION=eu-west-1
#STORAGE_S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
