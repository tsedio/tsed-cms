{
  "name": "tsed-rest",
  "description": "Expose legacy Ts.ED REST endpoints (/rest/github/* and /rest/warehouse) via Directus endpoint extension",
  "icon": "api",
  "version": "1.0.0",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-endpoint"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "directus:extension": {
    "type": "endpoint",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build --watch --no-minify",
    "link": "directus-extension link",
    "add": "directus-extension add"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "13.1.1"
  }
}
